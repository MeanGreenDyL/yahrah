    "question": {
      "id": "q-log-spray-shape",
      "type": "single",
      "prompt": "Five different usernames, one failed login each, within eight seconds, all from one external address. What is this pattern called?",
      "explanation": "A password spray tries one or a few common passwords across many accounts, rather than many passwords against one account. It is chosen precisely because per-account lockout thresholds do not trigger: each account sees only a single failure. Credential stuffing is the related technique that replays username and password pairs stolen from another breach.",
      "difficulty": 2,
      "choices": [
        {
          "id": "a",
          "text": "Password spraying",
          "why": "Correct. One password, many accounts, which stays under per-account lockout thresholds."
        },
        {
          "id": "b",
          "text": "Brute force against one account",
          "why": "A brute force hammers a single account with many passwords, and would trip lockout quickly."
        },
        {
          "id": "c",
          "text": "Credential stuffing",
          "why": "Close, but stuffing replays username and password pairs stolen elsewhere, rather than trying one password across accounts."
        },
        {
          "id": "d",
          "text": "A denial of service attempt",
          "why": "Nothing here is trying to exhaust a resource or deny availability."
        }
      ],
      "answer": "a",
